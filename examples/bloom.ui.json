{
  "$schema": "../innernet.ui.override.schema.json",
  "version": 1,
  "brand": {
    "name": "bloom",
    "encyclopediaName": "bloom garden",
    "tagline": "Big ideas. Happy little discoveries.",
    "description": "A playful workspace for finding projects, connecting ideas, and picking up where inspiration left off.",
    "creator": "bloom",
    "logo": null,
    "encyclopediaLogo": null,
    "icon": "/brand/bloom.svg",
    "appleIcon": "/brand/bloom-apple.png",
    "italicPrefix": "",
    "encyclopediaItalicPrefix": "",
    "headerLogo": {
      "src": "/brand/bloom.svg",
      "alt": "bloom",
      "width": 64,
      "height": 64
    },
    "showPublisherLink": false,
    "sourceLink": {
      "enabled": false
    },
    "attribution": {
      "enabled": false,
      "name": "bloom",
      "logo": null
    }
  },
  "theme": {
    "defaultMode": "light",
    "allowToggle": true,
    "light": {
      "bg": "#d7f7ee",
      "bg-sunk": "#b8eddc",
      "surface": "#f8fffc",
      "ink": "#172832",
      "ink-2": "#344c59",
      "muted": "#466474",
      "faint": "#627f8b",
      "line": "#172832",
      "line-strong": "#172832",
      "link": "#174fcc",
      "link-hover": "#123890",
      "visited": "#6240ab",
      "mark-bg": "#fff16a",
      "mark-ink": "#172832",
      "notice-bg": "#fff6ad",
      "notice-line": "#172832",
      "good": "#17683e",
      "ring": "#174fcc",
      "aurora-1": "#87e6cf",
      "aurora-2": "#aecaff",
      "aurora-3": "#fff16a",
      "aurora-opacity": 0.78,
      "shadow-sm": [
        {
          "x": 3,
          "y": 3,
          "blur": 0,
          "spread": 0,
          "color": "#172832"
        }
      ],
      "shadow": [
        {
          "x": 5,
          "y": 5,
          "blur": 0,
          "spread": 0,
          "color": "#172832"
        }
      ],
      "shadow-lg": [
        {
          "x": 8,
          "y": 8,
          "blur": 0,
          "spread": 0,
          "color": "#172832"
        }
      ]
    },
    "dark": {
      "bg": "#111e2a",
      "bg-sunk": "#172c38",
      "surface": "#213b49",
      "ink": "#e3fff5",
      "ink-2": "#badfd2",
      "muted": "#9fbbba",
      "faint": "#73928f",
      "line": "#75bca5",
      "line-strong": "#d4ffe6",
      "link": "#8fb7ff",
      "link-hover": "#cadcff",
      "visited": "#d4adff",
      "mark-bg": "#f7e768",
      "mark-ink": "#172832",
      "notice-bg": "#34382e",
      "notice-line": "#f7e768",
      "good": "#83e0ad",
      "ring": "#8fb7ff",
      "aurora-1": "#236b5a",
      "aurora-2": "#254991",
      "aurora-3": "#787228",
      "aurora-opacity": 0.6,
      "shadow-sm": [
        {
          "x": 3,
          "y": 3,
          "blur": 0,
          "spread": 0,
          "color": "#05101d"
        }
      ],
      "shadow": [
        {
          "x": 5,
          "y": 5,
          "blur": 0,
          "spread": 0,
          "color": "#05101d"
        }
      ],
      "shadow-lg": [
        {
          "x": 8,
          "y": 8,
          "blur": 0,
          "spread": 0,
          "color": "#05101d"
        }
      ]
    },
    "fonts": {
      "display": "inter",
      "serif": "newsreader",
      "sans": "inter",
      "mono": "jetbrains"
    },
    "effects": {
      "aurora": true,
      "grain": false,
      "motion": true
    },
    "style": "playful"
  },
  "layout": {
    "maxWidth": 1260,
    "searchWidth": 700,
    "articleWidth": 960,
    "density": "comfortable"
  },
  "navigation": {
    "home": [
      "wiki",
      "random",
      "categories",
      "guide"
    ],
    "search": [
      "wiki",
      "random",
      "guide"
    ],
    "wiki": [
      "search",
      "random",
      "categories",
      "allPages",
      "guide"
    ],
    "guide": [
      "search",
      "wiki",
      "random",
      "top"
    ],
    "headerSearch": [
      "wiki",
      "random",
      "guide"
    ],
    "headerWiki": [
      "search",
      "random",
      "guide"
    ],
    "labels": {
      "search": "Find your next idea",
      "wiki": "Project playground",
      "guide": "Get growing",
      "random": "Surprise me",
      "allPages": "All the good stuff",
      "categories": "Pick a path",
      "statistics": "By the numbers",
      "top": "Back to the top"
    }
  },
  "home": {
    "showCounts": true,
    "showExamples": true,
    "exampleQueries": [
      "is:article",
      "kind:docs",
      "fw:next",
      "lang:python"
    ],
    "showRecent": true,
    "recentLimit": 6,
    "showCurious": true,
    "autoFocus": false,
    "layout": "bento"
  },
  "search": {
    "suggestions": true,
    "suggestionLimit": 5,
    "debounceMs": 150,
    "focusShortcut": true,
    "perPage": 9,
    "showKnowledgePanel": true,
    "tabs": [
      "all",
      "articles",
      "docs",
      "repos",
      "folders"
    ]
  },
  "wiki": {
    "showContents": true,
    "showInfobox": true,
    "mainSections": [
      "welcome",
      "browse",
      "featured",
      "did-you-know",
      "news",
      "on-this-day",
      "areas"
    ],
    "articleSections": [
      "overview",
      "see-also",
      "technology",
      "structure",
      "history",
      "external-links"
    ]
  },
  "guide": {
    "showRecipe": true
  },
