    "search.tab.docs": "Documents",
    "search.tab.repos": "Repositories",
    "search.tab.folders": "Folders",
    "search.recentHeading": "Or return to a recent page",
    "search.openArticle": "Read in {wiki}",
    "wiki.mainTitle": "{wiki} · a reading room for your projects",
    "wiki.fromEncyclopedia": "From {wiki}, a collection of projects and their stories",
    "wiki.welcomeTitle": "Welcome to the reading room",
